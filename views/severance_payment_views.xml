<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_severance_payment_form" model="ir.ui.view">
            <field name="name">severance.payment.form</field>
            <field name="model">severance.payment</field>
            <field name="arch" type="xml">
                <form string="Severance Payment">
                    <header>
                        <button name="action_submit" type="object" string="Submit" invisible="state != 'draft'"  class="oe_highlight"/>
                        <button name="action_validate" type="object" string="Validate" invisible="state != 'submitted'"
                                class="oe_highlight"/>
                        <button name="action_cancel" type="object" string="Cancel" invisible="state != 'submitted'"
                                class="oe_highlight"/>
                        <button name="action_reset_draft" type="object" string="Reset to Draft"
                                invisible="state != 'validated'"  class="oe_highlight"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,submitted,validated,paid,cancelled"/>
                        <button name="%(severance_payment.action_report_severance_payment)d" string="Print PDF" type="action" class="oe_highlight"/>

                    </header>

                    <sheet>
                        <group>
                            <group>
                                <field name="employee_id"/>
                                <field name="department_id"/>
                                <field name="job_id"/>
                                <field name="monthly_salary"/>
                                <field name="is_usd" invisible="1"/>
                                <field name="exchange_rate"  invisible="is_usd != True"/>
                                <field name="approved_by"/>
                                <field name="validated_by"/>
                                <field name="currency_id"/>
                                <field name="reason"/>


                            </group>
                            <group>
                                <field name="payment_date"/>
                                <field name="contract_start_date"/>
                                <field name="contract_end_date"/>
                                <field name="years_worked"/>
                                <field name="months_worked"/>
                                <field name="days_worked"/>


                            </group>
                            <notebook>
                                <page name="Calculation" string="Gross Payment">

                                    <group>
                                        <group>
                                            <field name="annual_salary"/>
                                            <field name="payout_amount"/>
                                            <field name="payout_ratio"/>

                                        </group>


                                    </group>


                                </page>

                                <page name="Tax" string="Tax payment">
                                    <group>
                                        <group>
                                            <field name="adjusted_payout"/>
                                            <field name="adjusted_payout_after_dot"/>
                                        </group>

                                        <group>
                                            <field name="total_adjusted_payout"/>
                                        </group>
                                    </group>
                                </page>

                                <page name="Net" string="Net Payment">
                                    <group>
                                        <group>
                                            <field name="total_payment"/>

                                        </group>

                                    </group>
                                </page>

                            </notebook>
                        </group>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>

                </form>
            </field>
        </record>

        <record id="severance_payment_view_tree" model="ir.ui.view">
            <field name="name">Severance Payment</field>
            <field name="model">severance.payment</field>
            <field name="arch" type="xml">
                <list>
                    <field name="employee_id"/>
                    <field name="department_id"/>
                    <field name="job_id"/>
                    <field name="contract_start_date"/>
                    <field name="contract_end_date"/>
                    <field name="approved_by"/>
                    <field name="validated_by"/>
                    <field name="total_adjusted_payout"/>
                    <field name="total_payment"/>
                    <field name="state"/>
                </list>
            </field>
        </record>


        <record id="action_severance_payment" model="ir.actions.act_window">
            <field name="name">Severance Payments</field>
            <field name="res_model">severance.payment</field>
            <field name="view_mode">list,form</field>
        </record>


        <menuitem id="menu_severance_payment"
                  name="Severance Payments"
                  parent="hr.menu_hr_root"
                  sequence="20"/>


        <menuitem id="menu_severance_payment_form"
                  name="Severance Payments"
                  parent="menu_severance_payment"
                  action="action_severance_payment"/>

    </data>
</odoo>
